
var stack[100] = 0;
var memory[100] = 0;

var program = "
    ++++++++++
    [>+++++++>++++++++++>+++>+<<<<-]
    >++.>+.+++++++..+++.>++.<<+++++++++++++++.>.+++.------.--------.>+.>.
";

print_string(str) {
  let i = 0;
  while (str[i] != 0) {
    put_char(str[i]);
    i = i + 1;
  }

  print_endline();
}

exit_loop(prog, pos) {
  let count = 0;
  let result = 0;

  let break = 0;
  while !break {
    if prog[pos] == '[' {
      count = count + 1;
    }

    if prog[pos] == ']' {
      if count == 1 {
        break = 1;
      } else {
        count = count - 1;
      }
    }

    pos = pos + 1;
  }

  return pos;
}

execute(prog) {
  print_string(prog);
  let index = 0;
  let pos = 0;
  let top = 0;

  while prog[pos] != 0 {
    let char = prog[pos];
    let continue = 0;

    if char == '+' {
      memory[index] = memory[index] + 1;
    }

    if char == '-' {
      memory[index] = memory[index] - 1;
    }

    if char == '<' {
      index = index - 1;
    }

    if char == '>' {
      index = index + 1;
    }

    if char == '.' {
      put_char(memory[index]);
    }

    if char == '[' {
      if memory[index] == 0 {
        pos = exit_loop(prog, pos);
        continue = 1;
      }

      if !continue {
        stack[top] = pos;
        top = top + 1;
      }
    }

    if char == ']' {
      top = top - 1;

      if memory[index] != 0 {
        pos = stack[top];
        continue = 1;
      }
    }

    if !continue {
      pos = pos + 1;
    }
  }
}


main() {
  execute(program);
}
